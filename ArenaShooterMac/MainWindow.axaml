<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArenaShooterMac"
        mc:Ignorable="d"
        x:Class="ArenaShooterMac.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Width="1320"
        Height="900"
        MinWidth="1120"
        MinHeight="760"
        Background="#071018"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        FontFamily="Avenir Next, Segoe UI, sans-serif"
        Title="Arena Shooter Mac">
  <Window.Styles>
    <Style Selector="Button.command">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F1FAFF" />
      <Setter Property="Background" Value="#1A3340" />
      <Setter Property="BorderBrush" Value="#2A566A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.command:hover /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.fire">
      <Setter Property="Background" Value="#5E3B18" />
      <Setter Property="BorderBrush" Value="#A06E34" />
    </Style>
    <Style Selector="Button.utility">
      <Setter Property="Background" Value="#22304A" />
      <Setter Property="BorderBrush" Value="#4A6390" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24">
    <Border Grid.Row="0"
            CornerRadius="28"
            Padding="28"
            BorderBrush="#263E4D"
            BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#122635" Offset="0" />
          <GradientStop Color="#0A1721" Offset="0.65" />
          <GradientStop Color="#081118" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>

      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="10">
          <TextBlock Text="Arena Systems"
                     Foreground="#58D2B3"
                     FontSize="14"
                     FontWeight="Bold"
                     TextWrapping="Wrap" />
          <TextBlock Text="Neon Arena"
                     FontSize="42"
                     FontWeight="Black"
                     Foreground="#F6FBFF" />
          <TextBlock Text="A native F# macOS build with a faster-paced arena loop, on-screen controls, and code-drawn character assets."
                     FontSize="16"
                     Foreground="#A6BAC8"
                     MaxWidth="720"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="1" Padding="18,14" CornerRadius="18" Background="#10212B" BorderBrush="#233C4A" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Health" Foreground="#92A9B9" FontSize="12" />
            <TextBlock Text="{Binding HealthText}" FontSize="24" FontWeight="Bold" Foreground="#FFB6AD" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Padding="18,14" CornerRadius="18" Background="#10212B" BorderBrush="#233C4A" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Ammo" Foreground="#92A9B9" FontSize="12" />
            <TextBlock Text="{Binding AmmoText}" FontSize="24" FontWeight="Bold" Foreground="#FFD38A" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Padding="18,14" CornerRadius="18" Background="#10212B" BorderBrush="#233C4A" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Score" Foreground="#92A9B9" FontSize="12" />
            <TextBlock Text="{Binding ScoreText}" FontSize="24" FontWeight="Bold" Foreground="#F2F9FF" />
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Padding="18,14" CornerRadius="18" Background="#10212B" BorderBrush="#233C4A" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Wave" Foreground="#92A9B9" FontSize="12" />
            <TextBlock Text="{Binding WaveText}" FontSize="24" FontWeight="Bold" Foreground="#7DE9C9" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="0,24,0,0"
          ColumnDefinitions="Auto,340"
          ColumnSpacing="24">
      <Border Grid.Column="0"
              Padding="18"
              CornerRadius="28"
              BorderBrush="#263E4D"
              BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D1B26" Offset="0" />
            <GradientStop Color="#081118" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border CornerRadius="999"
                    Background="#102531"
                    BorderBrush="{Binding StatusBrush}"
                    BorderThickness="1"
                    Padding="14,8"
                    HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" />
                <TextBlock Text="{Binding StatusText}" Foreground="#EDF8FF" FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="18">
              <StackPanel>
                <TextBlock Text="Enemies" Foreground="#92A9B9" FontSize="12" />
                <TextBlock Text="{Binding EnemyText}" Foreground="#F6FBFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Engine" Foreground="#92A9B9" FontSize="12" />
                <TextBlock Text="Realtime" Foreground="#58D2B3" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1"
                  CornerRadius="24"
                  Padding="16"
                  BorderBrush="#1D3341"
                  BorderThickness="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A141C" Offset="0" />
                <GradientStop Color="#081018" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>

            <ItemsControl ItemsSource="{Binding Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="20" Rows="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>

              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CellViewModel">
                  <Border Width="38"
                          Height="38"
                          Margin="2"
                          Padding="3"
                          CornerRadius="10"
                          ClipToBounds="True"
                          Background="{Binding FloorBrush}"
                          BorderBrush="#173240"
                          BorderThickness="1">
                    <Grid>
                      <Border IsVisible="{Binding ShowWall}"
                              CornerRadius="8"
                              Background="#314D5F"
                              BorderBrush="#56788E"
                              BorderThickness="1">
                        <Grid>
                          <Rectangle Fill="#223846" Margin="4" RadiusX="4" RadiusY="4" />
                          <Path Data="M 6 12 L 30 12 M 6 24 L 30 24 M 16 4 L 16 12 M 22 24 L 22 34"
                                Stroke="#7C9CAE"
                                StrokeThickness="1.8"
                                StrokeLineCap="Round" />
                        </Grid>
                      </Border>

                      <Border IsVisible="{Binding ShowCover}"
                              CornerRadius="8"
                              Background="#8A6038"
                              BorderBrush="#D5B189"
                              BorderThickness="1">
                        <Grid>
                          <Rectangle Fill="#6A4729" Margin="4" RadiusX="3" RadiusY="3" />
                          <Path Data="M 8 8 L 30 30 M 30 8 L 8 30 M 7 18 L 31 18"
                                Stroke="#F0D5B1"
                                StrokeThickness="1.5"
                                StrokeLineCap="Round" />
                          <Path IsVisible="{Binding ShowCrackedCover}"
                                Data="M 20 6 L 17 14 L 23 19 L 18 28"
                                Stroke="#2C1D12"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round" />
                        </Grid>
                      </Border>

                      <Canvas IsVisible="{Binding ShowPlayer}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 14 1 L 24 14 L 14 27 L 4 14 Z"
                              Fill="#61E3C5"
                              Stroke="#E6FFF9"
                              StrokeThickness="2" />
                        <Path Data="M 14 6 L 19 14 L 14 22 L 9 14 Z"
                              Fill="#10303A"
                              Stroke="#B8FFF1"
                              StrokeThickness="1.2" />
                        <Ellipse Width="5" Height="5" Fill="#FFD27C" Canvas.Left="11.5" Canvas.Top="11.5" />
                      </Canvas>

                      <Canvas IsVisible="{Binding ShowDrone}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 14 2 L 25 12 L 21 24 L 7 24 L 3 12 Z"
                              Fill="#FF7F6E"
                              Stroke="#FFD8D2"
                              StrokeThickness="1.8" />
                        <Ellipse Width="4" Height="4" Fill="#FFE67A" Canvas.Left="8" Canvas.Top="11" />
                        <Ellipse Width="4" Height="4" Fill="#FFE67A" Canvas.Left="16" Canvas.Top="11" />
                      </Canvas>

                      <Canvas IsVisible="{Binding ShowBrute}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 15 1 L 26 8 L 26 22 L 15 29 L 4 22 L 4 8 Z"
                              Fill="#7B2C22"
                              Stroke="#FFC1B8"
                              StrokeThickness="2" />
                        <Path Data="M 15 6 L 21 10 L 21 20 L 15 24 L 9 20 L 9 10 Z"
                              Fill="#F68D5E"
                              Stroke="#FFF0E2"
                              StrokeThickness="1.2" />
                        <Ellipse Width="5" Height="5" Fill="#FFF191" Canvas.Left="12.5" Canvas.Top="12.5" />
                      </Canvas>

                      <Canvas IsVisible="{Binding ShowBullet}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="18" Height="18" Fill="#FFB347" Opacity="0.18" Canvas.Left="5" Canvas.Top="5" />
                        <Path Data="M 14 4 L 18 13 L 14 24 L 10 13 Z"
                              Fill="#FFEAB2"
                              Stroke="#FFB347"
                              StrokeThickness="1.5" />
                      </Canvas>

                      <Canvas IsVisible="{Binding ShowMedKit}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#6A1F28" BorderBrush="#FFB6AD" BorderThickness="1.2" />
                        <Rectangle Width="12" Height="4" Fill="#FFF6F5" RadiusX="1" RadiusY="1" Canvas.Left="8" Canvas.Top="12" />
                        <Rectangle Width="4" Height="12" Fill="#FFF6F5" RadiusX="1" RadiusY="1" Canvas.Left="12" Canvas.Top="8" />
                      </Canvas>

                      <Canvas IsVisible="{Binding ShowAmmoPack}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#21304D" BorderBrush="#A8C5FF" BorderThickness="1.2" />
                        <Rectangle Width="4" Height="12" Fill="#FFD38A" RadiusX="1" RadiusY="1" Canvas.Left="8" Canvas.Top="8" />
                        <Rectangle Width="4" Height="12" Fill="#FFD38A" RadiusX="1" RadiusY="1" Canvas.Left="16" Canvas.Top="8" />
                      </Canvas>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <Border Grid.Row="2"
                  Padding="18,14"
                  CornerRadius="18"
                  Background="#0E1D27"
                  BorderBrush="#213846"
                  BorderThickness="1">
            <TextBlock Text="{Binding MessageText}"
                       Foreground="#E4F3FF"
                       FontSize="15"
                       TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1" Spacing="18">
        <Border CornerRadius="24"
                Padding="20"
                Background="#0D1A23"
                BorderBrush="#233C4A"
                BorderThickness="1">
          <StackPanel Spacing="16">
            <TextBlock Text="Command Deck" FontSize="22" FontWeight="Bold" Foreground="#F5FBFF" />
            <TextBlock Text="Keyboard-first play, with button backups for trackpad and mouse control."
                       Foreground="#A6BAC8"
                       TextWrapping="Wrap" />

            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
              <Button Grid.Row="0" Grid.ColumnSpan="2" Classes="command" Content="Move Up" Tag="MoveUp" Click="OnCommandButtonClick" />
              <Button Grid.Row="1" Grid.Column="0" Classes="command" Content="Move Left" Tag="MoveLeft" Click="OnCommandButtonClick" />
              <Button Grid.Row="1" Grid.Column="1" Classes="command" Content="Move Right" Tag="MoveRight" Click="OnCommandButtonClick" />
              <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="command" Content="Move Down" Tag="MoveDown" Click="OnCommandButtonClick" />
              <Button Grid.Row="3" Grid.Column="0" Classes="command utility" Content="{Binding PauseText}" Tag="Pause" Click="OnCommandButtonClick" />
              <Button Grid.Row="3" Grid.Column="1" Classes="command utility" Content="Restart" Tag="Restart" Click="OnCommandButtonClick" />
            </Grid>
          </StackPanel>
        </Border>

        <Border CornerRadius="24"
                Padding="20"
                Background="#0D1A23"
                BorderBrush="#233C4A"
                BorderThickness="1">
          <StackPanel Spacing="16">
            <TextBlock Text="Weapons" FontSize="22" FontWeight="Bold" Foreground="#F5FBFF" />
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
              <Button Grid.Row="0" Grid.ColumnSpan="2" Classes="command fire" Content="Shoot Up" Tag="ShootUp" Click="OnCommandButtonClick" />
              <Button Grid.Row="1" Grid.Column="0" Classes="command fire" Content="Shoot Left" Tag="ShootLeft" Click="OnCommandButtonClick" />
              <Button Grid.Row="1" Grid.Column="1" Classes="command fire" Content="Shoot Right" Tag="ShootRight" Click="OnCommandButtonClick" />
              <Button Grid.Row="2" Grid.Column="0" Classes="command fire" Content="Shoot Down" Tag="ShootDown" Click="OnCommandButtonClick" />
              <Button Grid.Row="2" Grid.Column="1" Classes="command utility" Content="Reload" Tag="Reload" Click="OnCommandButtonClick" />
            </Grid>
          </StackPanel>
        </Border>

        <Border CornerRadius="24"
                Padding="20"
                Background="#0D1A23"
                BorderBrush="#233C4A"
                BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="Piloting" FontSize="22" FontWeight="Bold" Foreground="#F5FBFF" />
            <TextBlock Foreground="#A6BAC8" TextWrapping="Wrap">
              <Run Text="WASD" />
              <Run Text=" moves the mech one tile at a time." />
            </TextBlock>
            <TextBlock Foreground="#A6BAC8" TextWrapping="Wrap">
              <Run Text="Arrow keys" />
              <Run Text=" fire in four directions." />
            </TextBlock>
            <TextBlock Foreground="#A6BAC8" TextWrapping="Wrap">
              <Run Text="R" />
              <Run Text=" reloads immediately, and " />
              <Run Text="P" />
              <Run Text=" pauses the arena." />
            </TextBlock>
            <Separator Background="#203644" Margin="0,6" />
            <TextBlock Text="Visual Legend" Foreground="#F3FAFF" FontWeight="SemiBold" />
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="14" Height="14" Fill="#61E3C5" />
                <TextBlock Text="Player mech" Foreground="#D8EAF6" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="14" Height="14" Fill="#FF7F6E" />
                <TextBlock Text="Drone raider" Foreground="#D8EAF6" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="14" Height="14" Fill="#7B2C22" />
                <TextBlock Text="Brute raider" Foreground="#D8EAF6" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="14" Height="14" Fill="#FFD38A" />
                <TextBlock Text="Ammo cache" Foreground="#D8EAF6" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="14" Height="14" Fill="#FFB6AD" />
                <TextBlock Text="Field kit" Foreground="#D8EAF6" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
